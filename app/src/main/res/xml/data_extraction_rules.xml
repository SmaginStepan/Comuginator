<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules (Android 12+ backup and device transfer).
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Downloaded pictures are re-fetched from the server; never back them up. -->
        <exclude domain="file" path="image_cache" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="image_cache" />
    </device-transfer>
</data-extraction-rules>
