<?xml version="1.0" encoding="utf-8"?>
<!-- One cell of the conversation board. Sizes, colours and margins are set in code
     (BoardController) because they scale with the screen. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/boardCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivCard"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tvCardLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="#212121"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivFolderBadge"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_gravity="top|end"
        android:layout_margin="4dp"
        android:contentDescription="@null"
        android:src="@android:drawable/ic_menu_more"
        android:visibility="gone"
        app:tint="#F0A500" />
</FrameLayout>
