<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/editorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="8dp"
    android:paddingTop="8dp">

    <!-- Where we are, home, one folder up -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvEditorPath"
            style="@style/ComuginatorText.Section"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:text="@string/conversation_library" />

        <Button
            android:id="@+id/btnEditorHome"
            style="@style/ComuginatorButton.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/conversation_home"
            android:minWidth="0dp"
            android:minHeight="40dp"
            android:text="@string/conversation_home_glyph"
            android:visibility="invisible" />

        <Button
            android:id="@+id/btnEditorUp"
            style="@style/ComuginatorButton.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minHeight="40dp"
            android:text="@string/back"
            android:visibility="invisible" />
    </LinearLayout>

    <Button
        android:id="@+id/btnStarter"
        style="@style/ComuginatorButton.Secondary"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:minHeight="40dp"
        android:text="@string/starter_vocabulary" />

    <!-- The board, in edit mode: empty cells are "+" placeholders -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/boardScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp">

            <HorizontalScrollView
                android:id="@+id/boardScrollH"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <com.an0obis.comuginator.ui.conversation.FixedGridLayout
                    android:id="@+id/boardGrid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </HorizontalScrollView>
        </androidx.core.widget.NestedScrollView>

        <ProgressBar
            android:id="@+id/progressEditor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvAttribution"
        style="@style/ComuginatorText.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="4dp"
        android:text="@string/pictograms_attribution"
        android:textSize="11sp" />

</LinearLayout>
